/*
 * apollo_gpio_overlay.dtsi - 正点原子阿波罗 V2 板级 GPIO 占用（自动生成，勿手改）
 *
 * 数据源：apollo_alternate_gpio_pinmap.xlsx（手册 V1.1 表 1.5.1）。
 * 走片上复用的脚在 pinmux 里写实际 AF；纯 GPIO/按键/LED/晶振/模拟/软件模拟
 * SPI 脚保持默认输入态，网络名与连接说明写进 brd 属性留档。
 * pinmux = <port pin mode af>; mode: 0 input, 2 alternate；af: 0..15。
 */
/dts-v1/;

/ {
	#address-cells = <1>;
	#size-cells = <1>;
	soc {

		/* ---- DCMI ---- */
		dcmi_pclk_pa6: dcmi_pclk_pa6 {
			pinmux = <1 6 2 13>;
			brd,gpio = "PA6";
			brd,board-net = "DCMI_PCLK";
			brd,independent = "Y";
			brd,notes = "OLED/CAMERA 接口的 PCLK 脚";
		};
		dcmi_vsync_pb7: dcmi_vsync_pb7 {
			pinmux = <2 7 2 13>;
			brd,gpio = "PB7";
			brd,board-net = "DCMI_VSYNC";
			brd,independent = "Y";
			brd,notes = "OLED/CAMERA 接口的 VSYNC 脚";
		};
		dcmi_d6_pb8: dcmi_d6_pb8 {
			pinmux = <2 8 2 13>;
			brd,gpio = "PB8";
			brd,board-net = "DCMI_D6";
			brd,independent = "Y";
			brd,notes = "OLED/CAMERA 接口的 D6 脚";
		};
		dcmi_d7_pb9: dcmi_d7_pb9 {
			pinmux = <2 9 2 13>;
			brd,gpio = "PB9";
			brd,board-net = "DCMI_D7";
			brd,independent = "Y";
			brd,notes = "OLED/CAMERA 接口的 D7 脚";
		};
		dcmi_d0_pc6: dcmi_d0_pc6 {
			pinmux = <3 6 2 13>;
			brd,gpio = "PC6";
			brd,board-net = "DCMI_D0";
			brd,independent = "Y";
			brd,notes = "OLED/CAMERA 接口的 D0 脚";
		};
		dcmi_d1_pc7: dcmi_d1_pc7 {
			pinmux = <3 7 2 13>;
			brd,gpio = "PC7";
			brd,board-net = "DCMI_D1";
			brd,independent = "Y";
			brd,notes = "OLED/CAMERA 接口的 D1 脚";
		};
		dcmi_d5_pd3: dcmi_d5_pd3 {
			pinmux = <4 3 2 13>;
			brd,gpio = "PD3";
			brd,board-net = "DCMI_D5";
			brd,independent = "Y";
			brd,notes = "OLED/CAMERA 接口的 D5 脚";
		};
		dcmi_href_ph8: dcmi_href_ph8 {
			pinmux = <8 8 2 13>;
			brd,gpio = "PH8";
			brd,board-net = "DCMI_HREF";
			brd,independent = "Y";
			brd,notes = "OLED/CAMERA 接口的 HREF 脚";
		};

		/* ---- ETH ---- */
		rmii_ref_clk_pa1: rmii_ref_clk_pa1 {
			pinmux = <1 1 2 11>;
			brd,gpio = "PA1";
			brd,board-net = "RMII_REF_CLK";
			brd,independent = "N";
			brd,notes = "接 YT8512C 的 TXC 脚";
		};
		rmii_crs_dv_pa7: rmii_crs_dv_pa7 {
			pinmux = <1 7 2 11>;
			brd,gpio = "PA7";
			brd,board-net = "RMII_CRS_DV";
			brd,independent = "N";
			brd,notes = "接 YT8512C 的 CRS_DV 脚";
		};
		eth_mdc_pc1: eth_mdc_pc1 {
			pinmux = <3 1 2 11>;
			brd,gpio = "PC1";
			brd,board-net = "ETH_MDC";
			brd,independent = "N";
			brd,notes = "接 YT8512C 的 MDC 脚";
		};
		rmii_rxd0_pc4: rmii_rxd0_pc4 {
			pinmux = <3 4 2 11>;
			brd,gpio = "PC4";
			brd,board-net = "RMII_RXD0";
			brd,independent = "N";
			brd,notes = "接 YT8512C 的 RXD0 脚";
		};
		rmii_rxd1_pc5: rmii_rxd1_pc5 {
			pinmux = <3 5 2 11>;
			brd,gpio = "PC5";
			brd,board-net = "RMII_RXD1";
			brd,independent = "N";
			brd,notes = "接 YT8512C 的 RXD1 脚";
		};
		rmii_txd0_pg13: rmii_txd0_pg13 {
			pinmux = <7 13 2 11>;
			brd,gpio = "PG13";
			brd,board-net = "RMII_TXD0";
			brd,independent = "N";
			brd,notes = "接 YT8512C 的 TXD0 脚";
