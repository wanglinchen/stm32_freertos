		/* ---- I2C2 ---- */
		iic_scl_ph4: iic_scl_ph4 {
			pinmux = <8 4 2 4>;
			brd,gpio = "PH4";
			brd,board-net = "IIC_SCL";
			brd,independent = "N";
			brd,notes = "接 24C02、PCF8574、ST480MC、SH3001、AP3216C 和 ES8388 的 SCL；其中 PCF8574(U11) 为 I2C IO 扩展器，其 P0=BEEP、P1=AP_INT(AP3216C 中断)、P2=DCMI_PWDN、P3=USB_PWR、P4=6D_INT(SH3001 中断)、P5=RS485_RE、P6=ETH_RESET、P7=EXIO，均经 I2C 控制、不直接占用 MCU GPIO";
		};
		iic_sda_ph5: iic_sda_ph5 {
