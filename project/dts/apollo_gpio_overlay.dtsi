		};

		/* ---- FMC ---- */
		fmc_sdnwe_pc0: fmc_sdnwe_pc0 {
			pinmux = <3 0 2 12>;
			brd,gpio = "PC0";
			brd,board-net = "FMC_SDNWE";
			brd,independent = "N";
			brd,notes = "接 SDRAM 的 WE 脚";
		};
		fmc_sdne0_pc2: fmc_sdne0_pc2 {
