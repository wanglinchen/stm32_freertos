			brd,board-net = "T_PEN";
			brd,independent = "Y";
			brd,notes = "TFTLCD/RGBLCD 接口触摸屏 PEN 信号";
		};
		t_mosi_pi3: t_mosi_pi3 {
			pinmux = <9 3 0 0>;
			brd,gpio = "PI3";
			brd,board-net = "T_MOSI";
			brd,independent = "Y";
			brd,notes = "TFTLCD/RGBLCD 接口触摸屏 MOSI 信号";
		};
		t_cs_pi8: t_cs_pi8 {
			pinmux = <9 8 0 0>;
			brd,gpio = "PI8";
			brd,board-net = "T_CS";
			brd,independent = "Y";
			brd,notes = "TFTLCD/RGBLCD 接口触摸屏 CS 信号";
		};
		nrf_irq_gbc_key_pi11: nrf_irq_gbc_key_pi11 {
			pinmux = <9 11 0 0>;
			brd,gpio = "PI11";
			brd,board-net = "NRF_IRQ / GBC_KEY";
			brd,independent = "Y";
			brd,notes = "1、WIRELESS 接口 IRQ 信号；2、ATK-MODULE 接口的 KEY 引脚";
		};

	};
};
