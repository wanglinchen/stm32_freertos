			brd,gpio = "PF1";
			brd,board-net = "FMC_A1";
			brd,independent = "N";
			brd,notes = "FMC 总线地址线 A1(SDRAM 专用)";
		};
		fmc_a2_pf2: fmc_a2_pf2 {
			pinmux = <6 2 2 12>;
			brd,gpio = "PF2";
			brd,board-net = "FMC_A2";
			brd,independent = "N";
			brd,notes = "FMC 总线地址线 A2(SDRAM 专用)";
		};
		fmc_a3_pf3: fmc_a3_pf3 {
