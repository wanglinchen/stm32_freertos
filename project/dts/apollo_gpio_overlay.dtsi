		};
		fmc_d13_pd8: fmc_d13_pd8 {
			pinmux = <4 8 2 12>;
			brd,gpio = "PD8";
			brd,board-net = "FMC_D13";
			brd,independent = "N";
			brd,notes = "FMC 总线数据线 D13(LCD/SDRAM 共用)";
		};
		fmc_d14_pd9: fmc_d14_pd9 {
			pinmux = <4 9 2 12>;
			brd,gpio = "PD9";
			brd,board-net = "FMC_D14";
			brd,independent = "N";
			brd,notes = "FMC 总线数据线 D14(LCD/SDRAM 共用)";
