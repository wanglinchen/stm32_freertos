    };

    pin-151 {
        gpio-port = "D";
        gpio-pin = <7>;
        label = "FMC_NE1";
        independent;
        /* FMC总线的片选信号1，为TFTLCD片选信号 */
    };

    pin-96 {
        gpio-port = "D";
        gpio-pin = <8>;
        label = "FMC_D13";
        shared;
