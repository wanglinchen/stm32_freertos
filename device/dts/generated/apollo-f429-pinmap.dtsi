/* 自动生成，勿手改。来源：doc/hardware/pinmap/*.xlsx；刷新：build/build.py update */
/* 源：doc/hardware/pinmap/阿波罗V2 STM32F429开发板IO引脚分配表.xlsx */

pinmap {
    compatible = "brd,apollo-f429-pinmap";
    pin-count = <140>;

    pin-40 {
        gpio-port = "A";
        gpio-pin = <0>;
        label = "WK_UP";
        independent;
        /* 1，按键KEY_UP 2，可以做待机唤醒脚(WKUP) */
    };

    pin-41 {
        gpio-port = "A";
        gpio-pin = <1>;
        label = "RMII_REF_CLK";
        shared;
        /* 接YT8512C的TXC脚 */
    };

    pin-42 {
        gpio-port = "A";
        gpio-pin = <2>;
        label = "USART2_TX";
        alt-label = "ETH_MDIO";
        shared;
        /* 1，RS232串口2(COM2)RX脚(P7设置) 2，RS485 RX脚(P8设置) 3，YT8512C的MDIO脚 */
    };

    pin-47 {
        gpio-port = "A";
        gpio-pin = <3>;
        label = "USART2_RX";
        alt-label = "PWM_DAC";
        shared;
        /* 1，RS232串口2(COM2)TX脚(P7设置) 2，RS485 TX脚(P8设置) 3，PWM_DAC输出脚 */
    };

    pin-50 {
        gpio-port = "A";
        gpio-pin = <4>;
        label = "STM_DAC";
        alt-label = "GBC_LED";
        independent;
        /* 1，DAC输出脚 2，ATK-MODULE接口的LED引脚 */
    };

    pin-51 {
        gpio-port = "A";
        gpio-pin = <5>;
        label = "STM_ADC";
        independent;
        /* ADC输入引脚，同时做TPAD检测脚 */
    };

    pin-52 {
        gpio-port = "A";
        gpio-pin = <6>;
        label = "DCMI_PCLK";
        independent;
        /* OLED/CAMERA接口的PCLK脚 */
    };

    pin-53 {
        gpio-port = "A";
        gpio-pin = <7>;
        label = "RMII_CRS_DV";
        shared;
        /* 接YT8512C的CRS_DV脚 */
    };

    pin-119 {
        gpio-port = "A";
        gpio-pin = <8>;
        label = "REMOTE_IN";
        alt-label = "DCMI_XCLK";
        shared;
        /* 1，接LF0038红外接收头 2，OLED/CAMERA接口的XCLK脚 */
    };

    pin-120 {
        gpio-port = "A";
        gpio-pin = <9>;
        label = "USART1_TX";
        independent;
        /* 串口1 TX脚，默认连接CH340的RX(P11设置) */
    };

    pin-121 {
        gpio-port = "A";
        gpio-pin = <10>;
        label = "USART1_RX";
        independent;
        /* 串口1 RX脚，默认连接CH340的TX(P11设置) */
    };

    pin-122 {
        gpio-port = "A";
        gpio-pin = <11>;
        label = "USB_D-";
        alt-label = "CAN_RX";
        independent;
        /* 1，USB D-引脚(P9设置) 2，CAN_RX引脚(P9设置) */
    };

    pin-123 {
        gpio-port = "A";
        gpio-pin = <12>;
        label = "USB_D+";
        alt-label = "CAN_TX";
        independent;
        /* 1，USB D+引脚(P9设置) 2，CAN_TX引脚(P9设置) */
    };

    pin-124 {
        gpio-port = "A";
        gpio-pin = <13>;
        label = "JTMS";
        alt-label = "SWDIO";
        shared;
        /* JTAG/SWD仿真接口,没接任何外设 */
    };

    pin-137 {
        gpio-port = "A";
        gpio-pin = <14>;
        label = "JTCK";
        alt-label = "SWDCLK";
        shared;
        /* JTAG/SWD仿真接口,没接任何外设 */
    };

    pin-138 {
        gpio-port = "A";
        gpio-pin = <15>;
        label = "JTDI";
        alt-label = "DCMI_RESET";
        shared;
        /* 1，JTAG仿真口(JTDI) 2，OLED/CAMERA接口的RESET脚 */
    };

    pin-56 {
        gpio-port = "B";
        gpio-pin = <0>;
        label = "LED1";
        shared;
        /* 接DS1 LED灯(绿色) */
    };

    pin-57 {
        gpio-port = "B";
        gpio-pin = <1>;
        label = "LED0";
        shared;
        /* 接DS0 LED灯(红色) */
    };

    pin-58 {
        gpio-port = "B";
        gpio-pin = <2>;
        label = "BOOT1";
        shared;
        /* BOOT1,启动选择配置引脚(仅上电时用) */
    };

    pin-161 {
        gpio-port = "B";
        gpio-pin = <3>;
        label = "JTDO";
        alt-label = "DCMI_SDA";
        shared;
        /* 1，JTAG仿真口(JTDO) 2，OLED/CAMERA接口的SDA脚 */
    };

    pin-162 {
        gpio-port = "B";
        gpio-pin = <4>;
        label = "JTRST";
        alt-label = "DCMI_SCL";
        shared;
        /* 1，JTAG仿真口(JTRST) 2，OLED/CAMERA接口的SCL脚 */
    };

    pin-163 {
        gpio-port = "B";
        gpio-pin = <5>;
        label = "LCD_BL";
        independent;
        /* TFTLCD接口背光控制脚 */
    };

    pin-164 {
        gpio-port = "B";
        gpio-pin = <6>;
        label = "NC";
        independent;
        /* 未连接任何设备 */
    };

    pin-165 {
        gpio-port = "B";
        gpio-pin = <7>;
        label = "DCMI_VSYNC";
        independent;
        /* OLED/CAMERA接口的VSYNC脚 */
    };

    pin-167 {
        gpio-port = "B";
        gpio-pin = <8>;
        label = "DCMI_D6";
        independent;
        /* OLED/CAMERA接口的D6脚 */
    };

    pin-168 {
        gpio-port = "B";
        gpio-pin = <9>;
        label = "DCMI_D7";
        independent;
        /* OLED/CAMERA接口的D7脚 */
    };

    pin-79 {
        gpio-port = "B";
        gpio-pin = <10>;
        label = "USART3_TX";
        independent;
        /* 1，RS232串口3(COM3)RX脚(P8设置)  2，ATK-MODULE接口的RXD脚(P8设置) */
    };

    pin-80 {
        gpio-port = "B";
        gpio-pin = <11>;
        label = "USART3_RX";
        alt-label = "RMII_TX_EN";
        shared;
        /* 1，RS232串口3(COM3)TX脚(P8设置)  2，ATK-MODULE接口的TXD脚(P8设置) 3，接YT8512C的TXEN脚 */
    };

    pin-92 {
        gpio-port = "B";
        gpio-pin = <12>;
        label = "IIC_INT";
        alt-label = "1WIRE_DQ";
        shared;
        /* 1，接PCF8574的INT脚 2，接单总线接口(U10),即DHT11/DS18B20 */
    };

    pin-93 {
        gpio-port = "B";
        gpio-pin = <13>;
        label = "SPI2_SCK";
        independent;
        /* 接WIRELESS接口的SCK信号 */
    };

    pin-94 {
        gpio-port = "B";
        gpio-pin = <14>;
        label = "SPI2_MISO";
        independent;
        /* 接WIRELESS接口的MISO信号 */
    };

    pin-95 {
        gpio-port = "B";
        gpio-pin = <15>;
        label = "SPI2_MOSI";
        independent;
        /* 接WIRELESS接口的MOSI信号 */
    };

    pin-32 {
        gpio-port = "C";
        gpio-pin = <0>;
        label = "FMC_SDNWE";
        shared;
        /* 接SDRAM的WE脚 */
    };

    pin-33 {
        gpio-port = "C";
        gpio-pin = <1>;
        label = "ETH_MDC";
        shared;
        /* 接YT8512C的MDC脚 */
    };

    pin-34 {
        gpio-port = "C";
        gpio-pin = <2>;
        label = "FMC_SDNE0";
        shared;
        /* 接SDRAM的CS脚 */
    };

    pin-35 {
        gpio-port = "C";
        gpio-pin = <3>;
        label = "FMC_SDCKE0";
        shared;
        /* 接SDRAM的CKE脚 */
    };

    pin-54 {
        gpio-port = "C";
        gpio-pin = <4>;
        label = "RMII_RXD0";
        shared;
        /* 接YT8512C的RXD0脚 */
    };

    pin-55 {
        gpio-port = "C";
        gpio-pin = <5>;
        label = "RMII_RXD1";
        shared;
        /* 接YT8512C的RXD1脚 */
    };

    pin-115 {
        gpio-port = "C";
        gpio-pin = <6>;
        label = "DCMI_D0";
        independent;
        /* OLED/CAMERA接口的D0脚 */
    };

    pin-116 {
        gpio-port = "C";
        gpio-pin = <7>;
        label = "DCMI_D1";
        independent;
        /* OLED/CAMERA接口的D1脚 */
    };

    pin-117 {
        gpio-port = "C";
        gpio-pin = <8>;
        label = "SDIO_D0";
        alt-label = "DCMI_D2";
        shared;
        /* 1，TF卡接口的D0 2，OLED/CAMERA接口的D2脚 */
    };

    pin-118 {
        gpio-port = "C";
        gpio-pin = <9>;
        label = "SDIO_D1";
        alt-label = "DCMI_D3";
        shared;
