    };

    pin-10 {
        gpio-port = "C";
        gpio-pin = <15>;
        label = "RTC晶振";
        shared;
        /* 接32.768K晶振，不可用做IO */
    };

    pin-142 {
        gpio-port = "D";
        gpio-pin = <0>;
        label = "FMC_D2";
        shared;
