    };

    pin-154 {
        gpio-port = "G";
        gpio-pin = <11>;
        label = "LCD_B3";
        independent;
        /* RGBLCD接口的B3数据线 */
    };

    pin-155 {
        gpio-port = "G";
        gpio-pin = <12>;
        label = "NRF_CE";
        alt-label = "SPDIF_RX";
        shared;
